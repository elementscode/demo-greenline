// Config for the build and the app.
//
// Import it anywhere. Values are constant folded at build time, so changing
// one rebuilds the files that read it.
//
//   import config from "#config";
//   let name = config.database.name;
//
// env("NAME", fallback) reads a variable from the active environment's file:
// config/env/development.env, config/env/production.env, and so on.
//
// Keys are server only. A /** @browser */ tag on a property puts that
// property, and everything under it, in the browser bundle.
//
//   /** @browser */
//   public: { appName: "Acme" },
{
  package: {
    dependencies: {
      "@elements/app": "latest",
      "@elements/style": "latest",
      "@types/node": "latest",
      "stripe": "^22.6.2",
      "tslib": "latest",
    },
  },
  resolve: {
    imports: {
      "#config": "./config.jsoc",
      "#app/*": "./app/*",
    },
  },
  server: {
    port: env<number>("PORT", 4000),
    address: env("ADDRESS", "127.0.0.1"),
  },
  database: {
    name: "greenline",
    host: env("DB_HOST", "127.0.0.1"),
    port: env("DB_PORT", 5433),
    user: env("DB_USER", "postgres"),
    password: env("DB_PASSWORD", ""),
    default: env("DB_DEFAULT", ""),
  },
  email: {
    live: env<boolean>("EMAIL_LIVE", false),
    from: "Greenline Lawn Care <hello@greenline.test>",
    host: env("SMTP_HOST"),
    port: env<number>("SMTP_PORT", 587),
    user: env("SMTP_USER"),
    password: env("SMTP_PASSWORD"),
    startTls: true,
  },
  session: {
    expires: "30d",
  },

  /** @browser */
  public: {
    businessName: "Greenline Lawn Care",
    // Business hours and every displayed time are in the business's zone,
    // whatever zone the viewer's device is in.
    timeZone: "America/Chicago",
    openHour: 9,
    closeHour: 17,
  },

  // Card payments go through Stripe Checkout. Until a key is set, a job's pay
  // page offers a development-only simulated payment instead.
  stripe: {
    secretKey: env("STRIPE_SECRET_KEY", ""),
    webhookSecret: env("STRIPE_WEBHOOK_SECRET", ""),
  },
}
