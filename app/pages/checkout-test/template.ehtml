import "./style.css";
import { redirect } from "@elements/app";
import { Job } from "#app/shared/services/jobs";
import { AppShell } from "#app/shared/templates/app-shell";
import { money, when } from "#app/shared/format";
import { payTestInvoice } from "./services";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Separator } from "@elements/ui/separator";

function onPay(job: Job, state: { busy: boolean; error: string }) {
  state.busy = true;

  try {
    payTestInvoice(job.id);
    redirect(`/jobs/${job.id}?paid=1`);
  } catch (err: any) {
    state.error = err.message;
    state.busy = false;
  }
}

<html lang="en" class="page-checkout-test" (
  job: Job,
  private state: { busy: boolean; error: string } = { busy: false, error: "" },
)>
  <head>
    <title>Pay invoice · Greenline Lawn Care</title>
    <meta name="description" content="Pay your lawn care invoice.">
  </head>
  <body>
    <AppShell active="jobs">
      <div class="page-shell is-form stack is-lg">
        <a class="job-back" href={`/jobs/${job.id}`}>← Back to the job</a>

        <div class="page-head row">
          <div>
            <h1>Pay invoice</h1>
            <p class="lede">{job.serviceName} · {when(job.scheduledAt)}</p>
          </div>
          <Badge variant="accent" dot>Test mode</Badge>
        </div>

        <Card>
          <CardContent class="stack">
            <dl class="pay-lines">
              <dt>Service</dt>
              <dd>{job.serviceName}</dd>
              <dt>Address</dt>
              <dd>{job.address}</dd>
              <dt>Billed to</dt>
              <dd>{job.customerName}</dd>
            </dl>
            <Separator decorative />
            <div class="pay-total row">
              <span>Amount due</span>
              <strong>{money(job.amountCents)}</strong>
            </div>
          </CardContent>
          <CardFooter class="pay-actions">
            <Button variant="ghost" href={`/jobs/${job.id}?paid=0`}>Cancel</Button>
            <Button variant="primary" loading={state.busy} onclick={() => onPay(job, state)}>
              Pay {money(job.amountCents)}
            </Button>
          </CardFooter>
        </Card>

        <Alert e:if={state.error} variant="danger" description={state.error} />

        <p class="pay-note">
          This is the built-in test checkout, so no card is charged. Add
          <code>STRIPE_SECRET_KEY</code> to <code>config/env/development.env</code> and this
          button goes to real Stripe Checkout.
        </p>
      </div>
    </AppShell>
  </body>
</html>
