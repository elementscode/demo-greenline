import "./style.css";
import { redirect } from "@elements/app";
import { signup, SignupForm, MIN_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

type Errors = Partial<Record<keyof SignupForm, string[]>>;

interface State {
  form: SignupForm;
  errors: Errors;
  error: string;
}

function onSubmit(state: State) {
  try {
    let home = signup(state.form);
    state.errors = {};
    state.error = "";
    redirect(home);
  } catch (err: any) {
    state.errors = err.errors ?? {};
    state.error = err.errors ? "" : err.message;
  }
}

<html lang="en" class="page-signup" (
  private state: State = {
    form: { name: "", email: "", address: "", password: "" },
    errors: {},
    error: "",
  },
)>
  <head>
    <title>Create an account · Greenline Lawn Care</title>
    <meta name="description" content="Create a customer account to book lawn care.">
  </head>
  <body>
    <main class="auth">
      <div class="auth-panel stack is-lg">
        <a class="auth-brand row" href="/">
          <span class="auth-mark">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 20c0-8 5-14 15-15-1 10-7 15-15 15z"/>
              <path d="M5 20l7-7"/>
            </svg>
          </span>
          Greenline Lawn Care
        </a>

        <Card class="auth-card">
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(state)}>
              <div class="stack is-xs">
                <h1>Create an account</h1>
                <p class="hint">Book mowing, leaf cleanup and hedge trimming online.</p>
              </div>

              <Alert e:if={state.error} variant="danger" description={state.error} />

              <Field label="Full name" error={state.errors.name?.[0] ?? ""}>
                <Input name="name"
                       value={state.form.name}
                       attrs={{ id: "name", autocomplete: "name" }}
                       required />
              </Field>

              <Field label="Email" error={state.errors.email?.[0] ?? ""}>
                <Input type="email"
                       name="email"
                       value={state.form.email}
                       placeholder="you@example.com"
                       attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }}
                       required />
              </Field>

              <Field label="Service address" error={state.errors.address?.[0] ?? ""}>
                <Input name="address"
                       value={state.form.address}
                       placeholder="123 Main Street, Springfield"
                       attrs={{ id: "address", autocomplete: "street-address" }}
                       required />
              </Field>

              <Field label="Password"
                     description={`At least ${MIN_PASSWORD} characters.`}
                     error={state.errors.password?.[0] ?? ""}>
                <Input type="password"
                       name="password"
                       value={state.form.password}
                       attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }}
                       required />
              </Field>

              <Button type="submit" variant="primary" block>Create account</Button>
            </form>
          </CardContent>
        </Card>

        <p class="auth-switch">Already have an account? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
