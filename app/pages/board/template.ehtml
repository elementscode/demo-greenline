import "./style.css";
import { LiveView } from "@elements/app";
import { Job } from "#app/shared/services/jobs";
import { AppShell } from "#app/shared/templates/app-shell";
import { JobRow } from "#app/shared/templates/job-row";
import { day, money } from "#app/shared/format";
import { Card, CardContent } from "@elements/ui/card";
import { Empty } from "@elements/ui/empty";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@elements/ui/tabs";
import { ToggleGroup, ToggleGroupItem, type ChangeDetails } from "@elements/ui/toggle-group";

type Filter = "all" | "unpaid" | "paid";

interface DayGroup {
  id: string;
  label: string;
  jobs: Job[];
}

function scheduled(jobs: LiveView<Job>): Job[] {
  return jobs.filter((j) => j.status === "scheduled").sort((a, b) => +a.scheduledAt - +b.scheduledAt);
}

function done(jobs: LiveView<Job>): Job[] {
  return jobs.filter((j) => j.status !== "scheduled").sort((a, b) => +b.scheduledAt - +a.scheduledAt);
}

function isUnpaid(job: Job): boolean {
  return job.status === "completed" || job.status === "invoiced";
}

function filtered(jobs: LiveView<Job>, filter: Filter): Job[] {
  return done(jobs).filter((j) => filter === "all" || (filter === "paid" ? j.status === "paid" : isUnpaid(j)));
}

/** The queue reads as a schedule: one heading per work day. */
function byDay(list: Job[]): DayGroup[] {
  let groups: DayGroup[] = [];

  for (let job of list) {
    let label = day(job.scheduledAt);
    let last = groups[groups.length - 1];

    if (last && last.label === label) {
      last.jobs.push(job);
    } else {
      groups.push({ id: label, label, jobs: [job] });
    }
  }

  return groups;
}

/** One filter is always on: pressing the active one again keeps it. */
function keepOne(value: string, details: ChangeDetails) {
  if (!value) {
    details.cancel();
  }
}

function outstanding(jobs: LiveView<Job>): number {
  return done(jobs).filter(isUnpaid).reduce((sum, j) => sum + (j.amountCents ?? j.priceCents), 0);
}

function collected(jobs: LiveView<Job>): number {
  return done(jobs).filter((j) => j.status === "paid").reduce((sum, j) => sum + (j.amountCents ?? 0), 0);
}

function booked(jobs: LiveView<Job>): number {
  return scheduled(jobs).reduce((sum, j) => sum + j.priceCents, 0);
}

<html lang="en" class="page-board" (
  tab: "queue" | "completed",
  jobs: LiveView<Job>,
  private filter: { value: Filter } = { value: "all" as Filter },
)>
  <head>
    <title>{tab === "queue" ? "Queue" : "Completed"} · Greenline Lawn Care</title>
    <meta name="description" content="Scheduled and completed jobs.">
  </head>
  <body>
    <AppShell active={tab}>
      <div class="page-shell is-form stack is-xl">
        <div class="page-head row">
          <div>
            <h1>{tab === "queue" ? "Queue" : "Completed"}</h1>
            <p class="lede" e:if={tab === "queue"}>Every scheduled job, soonest first.</p>
            <p class="lede" e:else>Finished work and whether it's been paid.</p>
          </div>
        </div>

        <div class="board-stats">
          <Card size="sm">
            <CardContent class="board-stat">
              <div class="board-stat-label">Booked ahead</div>
              <div class="board-stat-value">{money(booked(jobs))}</div>
            </CardContent>
          </Card>
          <Card size="sm">
            <CardContent class="board-stat">
              <div class="board-stat-label">Awaiting payment</div>
              <div class="board-stat-value">{money(outstanding(jobs))}</div>
            </CardContent>
          </Card>
          <Card size="sm">
            <CardContent class="board-stat">
              <div class="board-stat-label">Collected</div>
              <div class="board-stat-value">{money(collected(jobs))}</div>
            </CardContent>
          </Card>
        </div>

        <Tabs value={tab} activation="manual">
          <TabsList label="Jobs">
            <TabsTrigger value="queue" href="/queue">
              Queue <span class="board-count">{scheduled(jobs).length}</span>
            </TabsTrigger>
            <TabsTrigger value="completed" href="/completed">
              Completed <span class="board-count">{done(jobs).length}</span>
            </TabsTrigger>
          </TabsList>

          <TabsContent value="queue" class="stack is-lg">
            <section class="board-day stack" e:for={group of byDay(scheduled(jobs))}>
              <h2 class="section-title">{group.label}</h2>
              <ul class="job-list">
                <li e:for={job of group.jobs}>
                  <JobRow {job} showCustomer={true} />
                </li>
              </ul>
            </section>
            <Empty e:if={scheduled(jobs).length === 0}
                   variant="outline"
                   description="The queue is clear. New bookings show up here as they come in." />
          </TabsContent>

          <TabsContent value="completed" class="stack">
            <ToggleGroup type="single" value={filter.value} size="sm" label="Payment" onValueChange={keepOne}>
              <ToggleGroupItem value="all">All</ToggleGroupItem>
              <ToggleGroupItem value="unpaid">Unpaid</ToggleGroupItem>
              <ToggleGroupItem value="paid">Paid</ToggleGroupItem>
            </ToggleGroup>
            <ul class="job-list" e:if={filtered(jobs, filter.value).length > 0}>
              <li e:for={job of filtered(jobs, filter.value)}>
                <JobRow {job} showCustomer={true} />
              </li>
            </ul>
            <Empty e:else variant="outline" description="Nothing here yet." />
          </TabsContent>
        </Tabs>
      </div>
    </AppShell>
  </body>
</html>
