import "./style.css";

<html lang="en" class="page-errors-not-found">
  <body class="error-page center">
    <main class="error-panel stack">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found.</h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <nav class="cluster error-actions">
        <a href="/" class="button is-primary">Go home</a>
        <a href="javascript:history.back()" class="button is-ghost">Go back</a>
      </nav>
    </main>
  </body>
</html>
