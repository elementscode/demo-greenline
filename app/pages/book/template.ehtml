import "./style.css";
import { redirect } from "@elements/app";
import config from "#config";
import { AppShell } from "#app/shared/templates/app-shell";
import { money, startTimes, timeLabel } from "#app/shared/format";
import { bookJob, weekday, Service, BookingForm, BookingErrors } from "./services";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { DatePicker } from "@elements/ui/date-picker";
import { Field, FieldContent, FieldDescription, FieldLabel, FieldTitle } from "@elements/ui/field";
import { NativeSelect } from "@elements/ui/native-select";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";
import { Textarea } from "@elements/ui/textarea";

interface State {
  form: BookingForm;
  errors: BookingErrors;
  error: string;
  busy: boolean;
}

const dateLabel = new Intl.DateTimeFormat("en-US", { timeZone: "UTC", weekday: "long", month: "long", day: "numeric" });

function selected(services: Service[], state: State): Service {
  return services.find((s) => s.id === state.form.serviceId) ?? services[0];
}

function isWeekend(date: string): boolean {
  return /^\d{4}-\d{2}-\d{2}$/.test(date) && (weekday(date) === 0 || weekday(date) === 6);
}

function hours(minutes: number): string {
  return minutes % 60 === 0 ? `${minutes / 60} hr` : `${(minutes / 60).toFixed(1)} hr`;
}

function dateError(state: State): string {
  if (isWeekend(state.form.date)) {
    return "We work weekdays only. Pick Monday through Friday.";
  }

  return state.errors.date?.[0] ?? "";
}

/** A longer service can push the chosen start past the last one that fits. */
function fitTime(state: State, service: Service | undefined) {
  if (service && !startTimes(service.durationMinutes).includes(state.form.time)) {
    state.form.time = startTimes(service.durationMinutes)[0];
  }
}

function onSubmit(state: State) {
  state.busy = true;

  try {
    let id = bookJob(state.form);
    redirect(`/jobs/${id}`);
  } catch (err: any) {
    state.errors = err.errors ?? {};
    state.error = err.errors ? "" : err.message;
    state.busy = false;
  }
}

<html lang="en" class="page-book" (
  services: Service[],
  today: string,
  first: string,
  serviceId: string,
  private state: State = {
    form: { serviceId, date: first, time: "09:00", description: "" },
    errors: {},
    error: "",
    busy: false,
  },
)>
  <head>
    <title>Book a job · Greenline Lawn Care</title>
    <meta name="description" content="Book lawn care service.">
  </head>
  <body>
    <AppShell active="book">
      <div class="page-shell is-form stack is-xl">
        <div class="page-head row">
          <div>
            <h1>Book a job</h1>
            <p class="lede">We work weekdays, {config.public.openHour}am to {config.public.closeHour - 12}pm.</p>
          </div>
        </div>

        <form class="stack is-lg" onsubmit={() => onSubmit(state)}>
          <Alert e:if={state.error} variant="danger" description={state.error} />

          <div class="stack is-sm">
            <h2 class="section-title" id="service-title">Service</h2>
            <RadioGroup value={state.form.serviceId}
                        class="book-services"
                        attrs={{ "aria-labelledby": "service-title" }}
                        onValueChange={(id) => fitTime(state, services.find((s) => s.id === id))}>
              <FieldLabel e:for={service of services}>
                <Field orientation="horizontal" reserveError={false}>
                  <FieldContent>
                    <FieldTitle>{service.name}</FieldTitle>
                    <span class="book-service-price">{money(service.priceCents)}</span>
                    <FieldDescription>{service.blurb}</FieldDescription>
                    <span class="book-service-duration">About {hours(service.durationMinutes)}</span>
                  </FieldContent>
                  <RadioGroupItem value={service.id} />
                </Field>
              </FieldLabel>
            </RadioGroup>
            <p e:if={state.errors.serviceId} class="error">{state.errors.serviceId?.[0]}</p>
          </div>

          <div class="stack is-sm">
            <h2 class="section-title">When</h2>
            <div class="book-when">
              <Field label="Date" error={dateError(state)}>
                <DatePicker value={state.form.date}
                            min={today}
                            disabledDates={{ dayOfWeek: [0, 6] }}
                            timeZone={config.public.timeZone}
                            block
                            required />
              </Field>

              <Field label="Start time"
                     description={`Latest start that finishes by ${config.public.closeHour - 12}pm.`}
                     error={state.errors.time?.[0] ?? ""}>
                <NativeSelect value={state.form.time} block>
                  <option e:for={t of startTimes(selected(services, state).durationMinutes)} value={t}>{timeLabel(t)}</option>
                </NativeSelect>
              </Field>
            </div>
          </div>

          <div class="stack is-sm">
            <h2 class="section-title">The work</h2>
            <Field label="Describe what you need" error={state.errors.description?.[0] ?? ""}>
              <Textarea value={state.form.description}
                        maxlength={2000}
                        placeholder="Which areas, anything we should watch out for, gate codes, pets..." />
            </Field>
          </div>

          <Card>
            <CardContent class="book-summary row">
              <span class="book-summary-text" e:if={!isWeekend(state.form.date) && state.form.date}>
                <strong>{selected(services, state).name}</strong>
                on {dateLabel.format(new Date(`${state.form.date}T00:00:00Z`))} at {timeLabel(state.form.time)}
                · <strong>{money(selected(services, state).priceCents)}</strong>, billed when the job is done
              </span>
              <span class="book-summary-text" e:else>Pick a weekday to see your booking.</span>
              <Button type="submit" variant="primary" loading={state.busy} disabled={isWeekend(state.form.date)}>
                Book job
              </Button>
            </CardContent>
          </Card>
        </form>
      </div>
    </AppShell>
  </body>
</html>
