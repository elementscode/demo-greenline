import "./style.css";
import { redirect } from "@elements/app";
import { signin } from "#app/shared/services/auth";
import { Alert, AlertDescription } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SigninForm {
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SigninForm, next: string) {
  try {
    let home = signin(form.email, form.password);
    form.error = "";
    redirect(next || home);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signin" (
  next: string,
  private form: SigninForm = { email: "", password: "", error: "" },
)>
  <head>
    <title>Sign in · Greenline Lawn Care</title>
    <meta name="description" content="Sign in to book and manage your lawn care jobs.">
  </head>
  <body>
    <main class="auth">
      <div class="auth-panel stack is-lg">
        <a class="auth-brand row" href="/">
          <span class="auth-mark">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 20c0-8 5-14 15-15-1 10-7 15-15 15z"/>
              <path d="M5 20l7-7"/>
            </svg>
          </span>
          Greenline Lawn Care
        </a>

        <Card class="auth-card">
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(form, next)}>
              <div class="stack is-xs">
                <h1>Sign in</h1>
                <p class="hint">Book service, follow your jobs, and pay invoices.</p>
              </div>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email">
                <Input type="email"
                       name="email"
                       value={form.email}
                       placeholder="you@example.com"
                       attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }}
                       required />
              </Field>

              <Field label="Password">
                <Input type="password"
                       name="password"
                       value={form.password}
                       attrs={{ id: "password", autocomplete: "current-password" }}
                       required />
              </Field>

              <Button type="submit" variant="primary" block>Sign in</Button>
            </form>
          </CardContent>
        </Card>

        <p class="auth-switch">New customer? <a href="/signup">Create an account</a></p>

        <Alert variant="info" role="none" class="auth-demo">
          <AlertDescription>
            Demo accounts, password <code>greenline1</code>: <code>crew@greenline.test</code> (company),
            <code>maria@example.com</code> and <code>dev@example.com</code> (customers).
          </AlertDescription>
        </Alert>
      </div>
    </main>
  </body>
</html>
